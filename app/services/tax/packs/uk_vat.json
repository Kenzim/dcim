  "metadata": {
    "title": "UK VAT",
    "description": "UK VAT for a seller registered in the UK: the standard, reduced and zero rates, and the zero-tax rows for business customers outside the UK with a valid tax ID. A starting point, not tax advice.",
    "rates_checked_on": "2026-11-22",
    "sources": [
      {
        "title": "GOV.UK, VAT rates (HM Revenue and Customs)",
        "url": "https://www.gov.uk/vat-rates"
      },
      {
        "title": "GOV.UK, VAT rates on different goods and services (last updated 10 July 2026)",
        "url": "https://www.gov.uk/guidance/rates-of-vat-on-different-goods-and-services"
      }
    ],
    "unconfirmed": [
      "The start dates of the reduced rate (1997-09-01) and of the zero rate (1973-04-01). The rates themselves are confirmed. Start dates before the apply date have no effect, because apply refuses past dates.",
      "The start date of the reverse charge rows (2021-01-01, the end of the Brexit transition period) is informational for the same reason."
    ],
    "assumptions": [
      "Northern Ireland is part of GB for services, and XI numbers are not used (owner question 11).",
      "There is no UK domestic reverse charge rule, because it does not cover hosting (owner question 16).",
      "The wording of the legal notes needs an adviser's confirmation (owner question 10)."
    ]
  },
  "legal_notes": {
    "gb_outside_scope_b2b": {
      "en": "Outside the scope of UK VAT: reverse charge. The customer accounts for any VAT due."
    },
    "outside_scope": {
      "en": "Outside the scope of VAT."
    }
  },
