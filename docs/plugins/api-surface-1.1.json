      "required": [
        "billing_account_id",
        "invoice_id",
        "reason"
      ]
    },
    "order.paid": {
      "before": false,
      "mutable": [],
      "optional": [],
      "permission": "billing.read",
      "required": [
        "billing_account_id",
        "currency",
        "order_id",
        "order_number",
        "total_cents"
