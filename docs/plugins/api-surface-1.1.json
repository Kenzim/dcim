        "params",
        "style",
        "timeout",
        "when"
      ],
      "required": [
        "id",
        "label"
      ]
    },
    "BadgeStyle": {
      "fields": [
        "text",
        "tone"
      ],
      "required": [
        "text"
      ]
    },
    "Condition": {
      "fields": [
        "eq",
        "falsy",
        "in",
        "ne",
        "state",
        "truthy"
      ],
      "required": [
        "state"
      ]
    },
    "Element": {
      "fields": [
        "action",
        "audience",
        "default",
        "empty",
        "format",
        "label",
        "map",
        "state",
        "text",
        "tone",
        "type",
        "value",
        "when"
      ],
      "required": [
        "type"
      ]
    },
    "Manifest": {
      "fields": [
        "actions",
        "author",
        "description",
        "entry",
        "events",
        "homepage",
        "hooks",
        "id",
        "licence",
        "mcp_tools",
        "name",
        "permissions",
        "provides",
        "rackflow_api",
        "schedules",
        "services",
        "settings",
        "tables",
        "ui",
        "version"
      ],
      "required": [
        "entry",
        "id",
        "name",
        "rackflow_api",
        "version"
      ]
