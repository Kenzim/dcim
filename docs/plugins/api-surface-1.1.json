  "permissions": [
    "billing.read",
    "currency.rates",
    "events.veto",
    "guest.exec",
    "http.outbound",
    "mcp.client",
    "mcp.staff",
    "notify.client",
    "service.read",
    "support.read",
    "tax.calculate",
    "tax.rule_pack",
    "tax.validate_id",
    "ui.client",
    "vm.power"
  ],
  "power_actions": [
    "off",
    "on",
    "reboot",
    "reset",
    "shutdown"
  ],
  "power_sources": [
    "admin",
    "billing",
    "client",
    "client_mcp",
    "console",
    "mcp",
    "plugin",
    "reseller"
  ],
  "provider_kinds": {
    "context": "current_context",
    "kinds": {
      "currency_rates": {
        "metered": [
          "rates"
        ],
        "methods": {
          "rates": 1
        },
        "permission": "currency.rates"
      },
      "tax_id_validator": {
        "metered": [
          "check_online"
        ],
        "methods": {
          "check_format": 2,
          "check_online": 1,
          "supports": 2
        },
        "permission": "tax.validate_id"
      },
      "tax_provider": {
        "metered": [
          "calculate"
        ],
        "methods": {
          "calculate": 1,
          "supports": 1
        },
        "permission": "tax.calculate"
      },
      "tax_rule_pack": {
        "metered": [
          "load"
        ],
        "methods": {
          "load": 1,
          "pack_id": 0,
          "versions": 0
        },
        "permission": "tax.rule_pack"
      }
    },
    "module": "rackflow_plugin.kinds",
    "types": {
      "CurrencyRate": [
        {
          "name": "currency",
          "required": true,
          "type": "str"
        },
        {
          "name": "units_per_base",
          "required": true,
          "type": "str"
        }
      ],
      "CurrencyRatesRequest": [
        {
          "name": "base",
          "required": true,
          "type": "str"
        },
        {
          "name": "period",
          "required": true,
          "type": "str"
        }
      ],
      "CurrencyRatesResult": [
        {
          "name": "source",
          "required": true,
          "type": "str"
        },
        {
          "name": "period_start",
          "required": true,
          "type": "date"
        },
        {
          "name": "period_end",
          "required": true,
          "type": "date"
        },
        {
          "name": "rates",
          "required": true,
          "type": "tuple[CurrencyRate, ...]"
        }
      ],
      "TaxIdCheckRequest": [
        {
          "name": "country",
          "required": true,
          "type": "str"
        },
        {
          "name": "tax_id",
          "required": true,
          "type": "str"
        },
        {
          "name": "id_type",
          "required": true,
          "type": "str"
        },
        {
          "name": "requester_country",
          "required": false,
          "type": "str or None"
        },
        {
          "name": "requester_tax_id",
          "required": false,
          "type": "str or None"
        }
      ],
      "TaxIdCheckResult": [
        {
          "name": "status",
          "required": true,
          "type": "\"valid\" or \"invalid\" or \"unavailable\""
        },
        {
          "name": "checked_at",
          "required": true,
          "type": "datetime"
        },
        {
          "name": "request_ref",
          "required": false,
          "type": "str or None"
        },
        {
          "name": "registered_name",
          "required": false,
          "type": "str or None"
        },
        {
          "name": "registered_address",
          "required": false,
          "type": "str or None"
        },
        {
          "name": "error_code",
          "required": false,
          "type": "str or None"
        }
      ],
      "TaxProviderLine": [
        {
          "name": "key",
          "required": true,
          "type": "str"
        },
        {
          "name": "net_cents",
          "required": true,
          "type": "int"
        },
        {
          "name": "tax_class",
          "required": true,
          "type": "str"
        },
        {
          "name": "kind",
          "required": true,
          "type": "str"
        },
        {
          "name": "product_code",
          "required": false,
          "type": "str or None"
        }
      ],
      "TaxProviderPart": [
        {
          "name": "name",
          "required": true,
          "type": "str"
        },
        {
          "name": "rate_percent",
          "required": true,
          "type": "str"
        },
        {
          "name": "jurisdiction",
          "required": true,
          "type": "str"
        },
        {
          "name": "base_cents",
          "required": true,
          "type": "int"
        },
        {
          "name": "tax_cents",
          "required": true,
          "type": "int"
        },
        {
          "name": "reverse_charge",
          "required": false,
          "type": "bool"
        },
        {
          "name": "legal_note",
          "required": false,
          "type": "str or None"
        }
      ],
      "TaxProviderRequest": [
        {
          "name": "tax_point_at",
          "required": true,
          "type": "datetime"
        },
        {
          "name": "currency",
          "required": true,
          "type": "str"
        },
        {
          "name": "prices_include_tax",
          "required": true,
          "type": "bool"
        },
        {
          "name": "seller",
          "required": true,
          "type": "dict"
        },
        {
          "name": "buyer",
          "required": true,
          "type": "dict"
        },
        {
          "name": "lines",
          "required": true,
          "type": "tuple[TaxProviderLine, ...]"
        }
      ],
      "TaxProviderResult": [
        {
          "name": "lines",
          "required": true,
          "type": "dict[str, tuple[TaxProviderPart, ...]]"
        },
        {
          "name": "reference",
          "required": false,
          "type": "str or None"
        }
      ]
    }
  },
