#!ipxe
# Embedded in the Rackflow netboot ISO (virtual CD). iPXE DHCP is already
# detected by dhcpd (user-class iPXE) and given the HTTP PXE script URL.
echo
echo Rackflow netboot ISO
echo
# The boot script URL (with its per-task nonce) only comes from this host's
# DHCP reservation while a boot task is pending, so there is no fallback URL.
autoboot || goto fail
goto eof

:fail
echo
echo Netboot failed. Check AIC link, DHCP, and that a boot task is pending.
shell

:eof
